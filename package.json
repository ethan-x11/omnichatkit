{
  "name": "omnichatkit",
  "version": "0.0.24-b",
  "description": "A modular React component library for building AG-UI based AI chat interfaces with native Generative UI(A2UI) and Shadcn styling.",
  "keywords": [
    "omnichatkit",
    "react",
    "nextjs",
    "ai-chat",
    "generative-ui",
    "chat-components",
    "llm-ui",
    "a2ui",
    "chatbot",
    "conversational-ui",
    "rsc"
  ],
  "homepage": "https://github.com/ethan-x11/omnichatkit#readme",
  "bugs": {
    "url": "https://github.com/ethan-x11/omnichatkit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ethan-x11/omnichatkit.git"
  },
  "license": "Apache-2.0",
  "author": "ethan-x11",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server/index.d.mts",
        "default": "./dist/server/index.mjs"
      },
      "require": {
        "types": "./dist/server/index.d.cts",
        "default": "./dist/server/index.cjs"
      }
    },
    "./dist/style.css": "./dist/style.css",
    "./style.css": "./dist/style.css"
  },
  "style": "./dist/style.css",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "lint": "tsc --noEmit",
    "prepare": "yarn lint && yarn build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@ag-ui/client": "^0.0.59",
    "@ag-ui/core": "^0.0.59",
    "@ai-sdk/react": "^4.0.96",
    "@base-ui/react": "^1.8.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-slot": "^1.3.3",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tsdown/css": "^0.23.0",
    "ai": "^7.0.93",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.5",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.13.7",
    "input-otp": "^1.5.0",
    "katex": "^0.18.5",
    "lucide-react": "^1.41.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react-day-picker": "^10.0.1",
    "react-is": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-resizable-layout": "^0.7.3",
    "react-resizable-panels": "^4.12.3",
    "react-syntax-highlighter": "^16.1.1",
    "react-textarea-autosize": "^8.5.9",
    "recharts": "^3.10.1",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "svelte": "^5.57.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/react-is": "^19.2.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "autoprefixer": "^10.5.5",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "yarn@4.18.0",
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  }
}
